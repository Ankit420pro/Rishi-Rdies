{
  "expo": {
    "name": "RishiRides",
    "slug": "RishiRides",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rishirides",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#315C4D"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RishiRide uses your location to set your pickup point when you ask it to."
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
